ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
# Railway Postgres public URL (Postgres service variables + TCP proxy), or a local database.
DATABASE_URL=postgresql://localhost:5432/btest
# Password for the deployed UI; any username. Also set on the Railway web service.
BTEST_UI_PASSWORD=
# Worker only: the restricted role strategy code connects as. Create it once with
#   CREATE ROLE btest_runner LOGIN PASSWORD '...';
# the worker grants it read access to market data and insert on runs at each start.
# Without it the worker refuses lab jobs and live decisions.
BTEST_RUNNER_DATABASE_URL=
# UI only: peers whose X-Forwarded-For is trusted (the reverse proxy). Default 127.0.0.1.
BTEST_FORWARDED_ALLOW_IPS=
